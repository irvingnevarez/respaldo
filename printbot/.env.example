# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (DALL-E 3 + embeddings) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Meta (Instagram + Facebook Graph API) ───────────────────────────────────
META_ACCESS_TOKEN=EAA...
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=           # Instagram Business Account ID
META_FB_PAGE_ID=           # Facebook Page ID
META_WEBHOOK_VERIFY_TOKEN= # Token arbitrario para verificar webhooks

# ─── TikTok Content Posting API v2 ──────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Base de datos ────────────────────────────────────────────────────────────
SQLITE_URL=sqlite+aiosqlite:///./printbot.db

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ─── Presupuesto mensual ─────────────────────────────────────────────────────
MONTHLY_BUDGET_USD=30.0
BUDGET_ALERT_THRESHOLD=20.0   # USD para enviar alerta
BUDGET_HARD_STOP=28.0         # USD para bloquear nuevas llamadas

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=cambia_esto_en_produccion

# ─── Modelos Claude ──────────────────────────────────────────────────────────
ORCHESTRATOR_MODEL=claude-sonnet-4-6
SUBAGENT_MODEL=claude-haiku-4-5
